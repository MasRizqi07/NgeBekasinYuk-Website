+"use client";
+
+import { useEffect, useRef, useState, useSyncExternalStore } from "react";
+import { useCartStore } from "@/stores/useCartStore";
+import type { ProductListing } from "@/types";
+
+export interface ResolvedCartState {
+  listings: ProductListing[];
+  isLoading: boolean;
+  droppedNotice: string | null;
+  clearDroppedNotice: () => void;
+}
+
+const subscribeCartHydration = (onStoreChange: () => void) => {
+  const api = (
+    useCartStore as unknown as {
+      persist?: {
+        onFinishHydration?: (cb: () => void) => () => void;
+      };
+    }
+  ).persist;
+  return api?.onFinishHydration?.(onStoreChange) ?? (() => {});
+};
+
+const getCartHydratedSnapshot = () => {
+  const api = (
+    useCartStore as unknown as {
+      persist?: {
+        hasHydrated?: () => boolean;
+      };
+    }
+  ).persist;
+  return api?.hasHydrated?.() ?? true;
+};
+
+/**
+ * Fetches live PostgreSQL listing data for listing IDs stored in useCartStore.
+ * Automatically drops SOLD, RESERVED, or ARCHIVED items with a visible notice.
+ */
+export function useResolvedCartListings(options?: {
+  fallbackToFirstActive?: boolean;
+}): ResolvedCartState {
+  const fallbackToFirstActive = options?.fallbackToFirstActive ?? false;
+  const { items, removeItems } = useCartStore();
+  const hydrated = useSyncExternalStore(
+    subscribeCartHydration,
+    getCartHydratedSnapshot,
+    () => false
+  );
+  const [listings, setListings] = useState<ProductListing[]>([]);
+  const [isLoading, setIsLoading] = useState(true);
+  const [droppedNotice, setDroppedNotice] = useState<string | null>(null);
+  const hadDroppedRef = useRef(false);
+
+  const itemIdsKey = items.map((i) => i.listingId).join(",");
+
+  useEffect(() => {
+    if (!hydrated) return;
+    let cancelled = false;
+
+    async function load() {
+      const ids = items.map((i) => i.listingId);
+
+      if (ids.length === 0) {
+        if (!fallbackToFirstActive || hadDroppedRef.current) {
+          if (!cancelled) {
+            setListings([]);
+            setIsLoading(false);
+          }
+          return;
+        }
+
+        try {
+          const res = await fetch("/api/listings?limit=1", { cache: "no-store" });
+          const json = await res.json();
+          if (!cancelled) {
+            setListings(Array.isArray(json?.data) ? json.data : []);
+            setIsLoading(false);
+          }
+        } catch {
+          if (!cancelled) {
+            setListings([]);
+            setIsLoading(false);
+          }
+        }
+        return;
+      }
+
+      try {
+        const res = await fetch(
+          `/api/listings?ids=${encodeURIComponent(ids.join(","))}`,
+          { cache: "no-store" }
+        );
+        const json = await res.json();
+        const activeList: ProductListing[] = Array.isArray(json?.data)
+          ? json.data.filter(
+              (item: ProductListing) => !item.status || item.status === "ACTIVE"
+            )
+          : [];
+
+        const activeMap = new Map(activeList.map((item) => [item.id, item]));
+        const unavailableIds = ids.filter((id) => !activeMap.has(id));
+
+        if (!cancelled && unavailableIds.length > 0) {
+          hadDroppedRef.current = true;
+          removeItems(unavailableIds);
+          setDroppedNotice(
+            `${unavailableIds.length} barang di keranjang tidak lagi tersedia (terjual, dipesan, atau diarsipkan) dan telah otomatis dihapus.`
+          );
+        }
+
+        if (!cancelled) {
+          const ordered = ids
+            .map((id) => activeMap.get(id))
+            .filter((item): item is ProductListing => Boolean(item));
+          setListings(ordered);
+          setIsLoading(false);
+        }
+      } catch {
+        if (!cancelled) {
+          setListings([]);
+          setIsLoading(false);
+        }
+      }
+    }
+
+    void load();
+    return () => {
+      cancelled = true;
+    };
+  }, [hydrated, itemIdsKey, fallbackToFirstActive, removeItems, items]);
+
+  return {
+    listings,
+    isLoading,
+    droppedNotice,
+    clearDroppedNotice: () => setDroppedNotice(null),
+  };
+}
diff --git a/apps/web/src/lib/http/problemDetails.ts b/apps/web/src/lib/http/problemDetails.ts
new file mode 100644
index 0000000..a89ce9f
--- /dev/null
+++ b/apps/web/src/lib/http/problemDetails.ts
@@ -0,0 +1,87 @@
+import { NextResponse } from "next/server";
+
+export interface ProblemDetailsInput {
+  type?: string;
+  title: string;
+  status: number;
+  detail: string;
+  instance?: string;
+  error: string;
+  errors?: unknown;
+}
+
+/**
+ * Emits an RFC 9457 Problem Details JSON response (`application/problem+json`)
+ * while preserving `error` and `message` keys for existing client consumers.
+ */
+export function problemResponse(input: ProblemDetailsInput) {
+  const slug = input.error.toLowerCase().replace(/_/g, "-");
+  const body: Record<string, unknown> = {
+    type: input.type ?? `https://ngebekasinyuk.id/errors/${slug}`,
+    title: input.title,
+    status: input.status,
+    detail: input.detail,
+    error: input.error,
+    message: input.detail,
+  };
+
+  if (input.instance) {
+    body.instance = input.instance;
+  }
+  if (input.errors !== undefined) {
+    body.errors = input.errors;
+  }
+
+  return NextResponse.json(body, {
+    status: input.status,
+    headers: {
+      "Content-Type": "application/problem+json; charset=utf-8",
+    },
+  });
+}
+
+export function requestPathname(request: Request): string {
+  try {
+    return new URL(request.url).pathname;
+  } catch {
+    return "/api/listings";
+  }
+}
+
+export function handleRouteError(
+  err: unknown,
+  request: Request,
+  fallbackLabel: string
+) {
+  if (
+    err instanceof Error &&
+    "status" in err &&
+    "code" in err &&
+    "title" in err &&
+    typeof (err as { status: unknown }).status === "number" &&
+    typeof (err as { code: unknown }).code === "string" &&
+    typeof (err as { title: unknown }).title === "string"
+  ) {
+    const typedErr = err as Error & {
+      status: number;
+      code: string;
+      title: string;
+    };
+    return problemResponse({
+      error: typedErr.code,
+      title: typedErr.title,
+      status: typedErr.status,
+      detail: typedErr.message,
+      instance: requestPathname(request),
+    });
+  }
+
+  console.error(`[${fallbackLabel}]`, err);
+  return problemResponse({
+    error: "INTERNAL_SERVER_ERROR",
+    title: "Kesalahan Server Internal",
+    status: 500,
+    detail: "Terjadi kesalahan pada server saat memproses permintaan.",
+    instance: requestPathname(request),
+  });
+}
