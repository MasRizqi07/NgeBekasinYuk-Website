+  return {
+    id: row.sellerId,
+    name: row.storeName || row.sellerName,
+    avatar: row.sellerAvatar || "/assets/products/ipad-mini-unboxing.png",
+    verifiedKYC: Boolean(row.sellerIsVerified),
+    isVerified: Boolean(row.sellerIsVerified),
+    isOnline: true,
+    trustScore: Math.min(100, Math.round(rating * 20)),
+    rating,
+    reviewCount: totalSales,
+    location: city,
+    city,
+    joinedDate: new Date(row.sellerCreatedAt).toISOString(),
+    responseTime: "± 10 menit",
+    successTransactions: totalSales,
+  };
+}
+
+/**
+ * Maps raw PostgreSQL listing rows to the public ProductListing DTO contract.
+ * Excludes all sensitive user PII (email, phone) and hides minNegoPrice from non-owners.
+ */
+export function mapListingToDto(
+  row: ListingRawRow,
+  viewer?: ListingAuthorViewer | null
+): ListingPublicDto {
+  const conditionMeta = getConditionDisplay(row.condition);
+  const resolvedCategoryLabel = row.categoryLabel || getCategoryLabel(row.category);
+  const seller = buildSellerDto(row);
+  const isPrivilegedViewer =
+    Boolean(viewer) &&
+    (viewer!.id === row.sellerId || viewer!.role === "ADMIN");
+
+  const dto: ListingPublicDto = {
+    id: row.id,
+    slug: row.slug,
+    title: row.title,
+    price: row.price,
+    ...(row.originalPrice != null ? { originalPrice: row.originalPrice } : {}),
+    category: row.category as ProductListing["category"],
+    categoryLabel: resolvedCategoryLabel,
+    brand: row.brand,
+    model: row.model,
+    condition: row.condition as TechCondition,
+    conditionLabel: conditionMeta.label,
+    conditionScore: conditionMeta.score,
+    canNego: row.canNego,
+    ...(isPrivilegedViewer && row.minNegoPrice != null
+      ? { minNegoPrice: row.minNegoPrice }
+      : {}),
+    status: row.status as ListingStatus,
+    sellerId: row.sellerId,
+    images: row.images.length > 0 ? row.images : [],
+    location: seller.city,
+    city: seller.city,
+    description: row.description,
+    specifications: {
+      Merek: row.brand,
+      Model: row.model,
+      Kategori: resolvedCategoryLabel,
+      Kondisi: conditionMeta.label,
+    },
+    completeness: ["Unit Utama", "Kemasan Aman Escrow"],
+    diagnosticPassed: Boolean(row.sellerIsVerified),
+    diagnosticTool: row.sellerIsVerified ? "Verified Seller Check" : undefined,
+    seller,
+    createdAt: new Date(row.createdAt).toISOString(),
+    updatedAt: new Date(row.updatedAt).toISOString(),
+    viewsCount: row.viewsCount,
+    favoritesCount: row.favoritesCount,
+    isSold: row.status === "SOLD",
+  };
+
+  return dto;
+}
diff --git a/apps/web/src/domain/listing/listingMetadata.ts b/apps/web/src/domain/listing/listingMetadata.ts
new file mode 100644
index 0000000..861286c
--- /dev/null
+++ b/apps/web/src/domain/listing/listingMetadata.ts
@@ -0,0 +1,114 @@
+export const LISTING_CATEGORY_SLUGS = [
+  "smartphone",
+  "laptop",
+  "audio",
+  "pc-gaming",
+  "console",
+  "camera",
+  "accessories",
+] as const;
+
+export type ListingCategorySlug = (typeof LISTING_CATEGORY_SLUGS)[number];
+
+export const CATEGORY_LABELS: Record<ListingCategorySlug, string> = {
+  smartphone: "Smartphone & Tablet",
+  laptop: "Laptop & Ultrabook",
+  audio: "Audio & Headphone",
+  "pc-gaming": "PC Part & GPU",
+  console: "Konsol & Handheld",
+  camera: "Kamera & Lensa",
+  accessories: "Aksesoris Tech",
+};
+
+export const LISTING_CONDITION_VALUES = [
+  "BRAND_NEW_SEALED",
+  "BRAND_NEW",
+  "LIKE_NEW",
+  "VERY_GOOD",
+  "NORMAL_USE",
+  "FAIR",
+  "MINOR_SCRATCHES",
+  "MINOR_DEFECT",
+] as const;
+
+export type ListingConditionCode = (typeof LISTING_CONDITION_VALUES)[number];
+
+export interface ConditionDisplayMeta {
+  label: string;
+  score: number;
+  equivalentCodes: ListingConditionCode[];
+}
+
+export const CONDITION_META: Record<ListingConditionCode, ConditionDisplayMeta> = {
+  BRAND_NEW_SEALED: {
+    label: "Segel Baru (100%)",
+    score: 100,
+    equivalentCodes: ["BRAND_NEW_SEALED", "BRAND_NEW"],
+  },
+  BRAND_NEW: {
+    label: "Segel Baru (100%)",
+    score: 100,
+    equivalentCodes: ["BRAND_NEW", "BRAND_NEW_SEALED"],
+  },
+  LIKE_NEW: {
+    label: "Seperti Baru (99%)",
+    score: 99,
+    equivalentCodes: ["LIKE_NEW"],
+  },
+  VERY_GOOD: {
+    label: "Sangat Mulus (96%)",
+    score: 96,
+    equivalentCodes: ["VERY_GOOD", "NORMAL_USE"],
+  },
+  NORMAL_USE: {
+    label: "Pemakaian Wajar (95%)",
+    score: 95,
+    equivalentCodes: ["NORMAL_USE", "VERY_GOOD"],
+  },
+  FAIR: {
+    label: "Kondisi Layak (90%)",
+    score: 90,
+    equivalentCodes: ["FAIR", "MINOR_SCRATCHES"],
+  },
+  MINOR_SCRATCHES: {
+    label: "Lecet Pemakaian (90%)",
+    score: 90,
+    equivalentCodes: ["MINOR_SCRATCHES", "FAIR"],
+  },
+  MINOR_DEFECT: {
+    label: "Minus / Rusak Ringan",
+    score: 80,
+    equivalentCodes: ["MINOR_DEFECT"],
+  },
+};
+
+export function getCategoryLabel(category: string): string {
+  return (CATEGORY_LABELS as Record<string, string>)[category] ?? "Gadget Lainnya";
+}
+
+export function getConditionDisplay(condition: string): ConditionDisplayMeta {
+  return (
+    (CONDITION_META as Record<string, ConditionDisplayMeta>)[condition] ?? {
+      label: condition,
+      score: 90,
+      equivalentCodes: [condition as ListingConditionCode],
+    }
+  );
+}
+
+export function expandConditionFilter(conditionParam: string): string[] {
+  const parts = conditionParam
+    .split(",")
+    .map((p) => p.trim())
+    .filter(Boolean);
+  const expanded = new Set<string>();
+  for (const code of parts) {
+    const meta = (CONDITION_META as Record<string, ConditionDisplayMeta>)[code];
+    if (meta) {
+      for (const eq of meta.equivalentCodes) {
+        expanded.add(eq);
+      }
+    }
+  }
+  return Array.from(expanded);
+}
diff --git a/apps/web/src/domain/listing/listingService.ts b/apps/web/src/domain/listing/listingService.ts
new file mode 100644
index 0000000..f3c23c1
--- /dev/null
+++ b/apps/web/src/domain/listing/listingService.ts
@@ -0,0 +1,1124 @@
+import crypto from "crypto";
+import { Prisma } from "@prisma/client";
+import { z } from "zod";
+import { prisma } from "@/server/db/prisma";
+import { generateInternalId } from "@/domain/id";
+import {
+  LISTING_STATUS,
+  TERMINAL_ORDER_STATUSES,
+  type ListingStatus,
+} from "@/domain/listing/listingStatus";
+import {
+  expandConditionFilter,
+  getCategoryLabel,
+  LISTING_CATEGORY_SLUGS,
+} from "@/domain/listing/listingMetadata";
+import {
+  mapListingToDto,
+  type ListingAuthorViewer,
+  type ListingPublicDto,
+  type ListingRawRow,
+} from "@/domain/listing/listingDto";
+import {
+  CreateListingSchema,
+  ListListingsQuerySchema,
+  UpdateListingSchema,
+} from "@/lib/validations";
+import {
+  MAX_LISTING_IMAGES_PER_LISTING,
+  validateUploadedImageBuffer,
+  ImageValidationError,
+} from "@/lib/storage/imageValidation";
+import { generateSafeImageStorageKey } from "@/lib/storage/StorageProvider";
+import { defaultListingStorage } from "@/lib/storage/LocalDiskProvider";
+
+export class ListingServiceError extends Error {
+  public readonly status: number;
+  public readonly code: string;
+  public readonly title: string;
+
+  constructor(code: string, title: string, message: string, status: number) {
+    super(message);
+    this.name = "ListingServiceError";
+    this.code = code;
+    this.title = title;
+    this.status = status;
+  }
+}
+
+export interface ListListingsInput {
+  q?: string;
+  category?: string;
+  condition?: string;
+  brand?: string;
+  minPrice?: number;
+  maxPrice?: number;
+  sellerId?: string;
+  status?: ListingStatus;
+  mine?: boolean;
+  canNego?: boolean;
+  verifiedOnly?: boolean;
+  city?: string;
+  ids?: string[];
+  sort?: "newest" | "price_asc" | "price_desc" | "popular";
+  limit?: number;
+  cursor?: string;
+}
+
+export interface ListListingsResult {
+  data: ListingPublicDto[];
+  pagination: {
+    limit: number;
+    nextCursor: string | null;
+    hasMore: boolean;
+  };
+}
+
+const CursorPayloadSchema = z.object({
+  sort: z.enum(["newest", "price_asc", "price_desc", "popular"]),
+  createdAt: z.string().datetime(),
+  id: z.string().min(1),
+  price: z.number().int().optional(),
+  viewsCount: z.number().int().optional(),
+});
+
+type CursorPayload = z.infer<typeof CursorPayloadSchema>;
+
+function encodeCursor(payload: CursorPayload): string {
+  return Buffer.from(JSON.stringify(payload), "utf8").toString("base64url");
+}
+
+function decodeCursor(
+  cursor: string,
+  expectedSort: CursorPayload["sort"]
+): CursorPayload {
+  try {
+    const raw = Buffer.from(cursor, "base64url").toString("utf8");
+    const parsed = CursorPayloadSchema.safeParse(JSON.parse(raw));
+    if (!parsed.success || parsed.data.sort !== expectedSort) {
+      throw new Error("Invalid cursor payload");
+    }
+    return parsed.data;
+  } catch {
+    throw new ListingServiceError(
+      "INVALID_CURSOR",
+      "Cursor Tidak Valid",
+      "Parameter cursor paginasi tidak valid atau tidak sesuai urutan.",
+      400
+    );
+  }
+}
+
+function slugify(input: string): string {
+  const base = input
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 64);
+  return base || "gadget";
+}
+
+function escapeLikePattern(input: string): string {
+  return input.replace(/[\\%_]/g, "\\$&");
+}
+
+function selectListingColumnsFragment(): Prisma.Sql {
+  return Prisma.sql`
+    SELECT
+      l."id",
+      l."slug",
+      l."title",
+      l."description",
+      l."price",
+      l."originalPrice",
+      l."category",
+      l."categoryLabel",
+      l."brand",
+      l."model",
+      l."condition",
+      l."canNego",
+      l."minNegoPrice",
+      l."status",
+      l."sellerId",
+      l."viewsCount",
+      l."favoritesCount",
+      l."createdAt",
+      l."updatedAt",
+      u."name" AS "sellerName",
+      u."avatar" AS "sellerAvatar",
+      u."isVerified" AS "sellerIsVerified",
+      u."createdAt" AS "sellerCreatedAt",
+      sp."storeName" AS "storeName",
+      sp."storeSlug" AS "storeSlug",
+      sp."city" AS "storeCity",
+      sp."rating" AS "storeRating",
+      sp."totalSales" AS "storeTotalSales",
+      sp."reputationBadge" AS "storeBadge",
+      COALESCE(
+        ARRAY(
+          SELECT li."url"
+          FROM "ListingImage" li
+          WHERE li."listingId" = l."id"
+          ORDER BY li."isPrimary" DESC, li."sortOrder" ASC, li."createdAt" ASC
+        ),
+        ARRAY[]::text[]
+      ) AS "images"
+    FROM "ProductListing" l
+    INNER JOIN "User" u ON u."id" = l."sellerId"
+    LEFT JOIN "SellerProfile" sp ON sp."userId" = u."id"
+  `;
+}
+
+/**
+ * Fetches a single listing row (1 SQL query) using Prisma's SELECT builder.
+ */
+async function fetchListingRowById(id: string): Promise<ListingRawRow | null> {
+  const rows = await prisma.$queryRaw<ListingRawRow[]>`
+    ${selectListingColumnsFragment()}
+    WHERE l."id" = ${id}
+    LIMIT 1
+  `;
+  return rows[0] ?? null;
+}
+
+export function parseListListingsQuery(
+  searchParams: URLSearchParams
+): ListListingsInput {
+  const rawObject = Object.fromEntries(searchParams.entries());
+  const parsed = ListListingsQuerySchema.safeParse(rawObject);
+  if (!parsed.success) {
+    throw new ListingServiceError(
+      "VALIDATION_ERROR",
+      "Parameter Query Tidak Valid",
+      "Parameter pencarian atau filter tidak valid.",
+      400
+    );
+  }
+
+  const data = parsed.data;
+  if (
+    data.minPrice !== undefined &&
+    data.maxPrice !== undefined &&
+    data.minPrice > data.maxPrice
+  ) {
+    throw new ListingServiceError(
+      "INVALID_PRICE_RANGE",
+      "Rentang Harga Tidak Valid",
+      "minPrice tidak boleh melebihi maxPrice.",
+      400
+    );
+  }
+
+  let ids: string[] | undefined;
+  if (data.ids) {
+    ids = Array.from(
+      new Set(
+        data.ids
+          .split(",")
+          .map((item) => item.trim())
+          .filter(Boolean)
+      )
+    );
+    if (ids.length === 0) {
+      ids = undefined;
+    } else if (ids.length > 20) {
+      throw new ListingServiceError(
+        "TOO_MANY_IDS",
+        "Terlalu Banyak ID",
+        "Maksimal 20 listing ID per permintaan batch.",
+        400
+      );
+    }
+  }
+
+  if (
+    data.category &&
+    data.category !== "all" &&
+    !(LISTING_CATEGORY_SLUGS as readonly string[]).includes(data.category)
+  ) {
+    throw new ListingServiceError(
+      "INVALID_CATEGORY",
+      "Kategori Tidak Valid",
+      "Kategori gadget yang dipilih tidak dikenal.",
+      400
+    );
+  }
+
+  return {
+    q: data.q,
+    category: data.category === "all" ? undefined : data.category,
+    condition: data.condition,
+    brand: data.brand,
+    minPrice: data.minPrice,
+    maxPrice: data.maxPrice,
+    sellerId: data.sellerId,
+    status: data.status as ListingStatus | undefined,
+    mine: data.mine === "true" || data.mine === "1",
+    canNego:
+      data.canNego === undefined
+        ? undefined
+        : data.canNego === "true" || data.canNego === "1",
+    verifiedOnly:
+      data.verifiedOnly === undefined
+        ? undefined
+        : data.verifiedOnly === "true" || data.verifiedOnly === "1",
+    city: data.city && data.city !== "Semua Kota" ? data.city : undefined,
+    ids,
+    sort: data.sort,
+    limit: data.limit,
+    cursor: data.cursor,
+  };
+}
+
+/**
+ * Shared server-side listing catalog query used by both GET /api/listings and Server Components.
+ * Executes a single SQL query (<= 3 SQL query budget) with deterministic keyset pagination.
+ */
+export async function listListings(
+  params: ListListingsInput = {},
+  viewer?: ListingAuthorViewer | null
+): Promise<ListListingsResult> {
+  const sort = params.sort ?? "newest";
+  const limit = Math.min(Math.max(params.limit ?? 20, 1), 50);
+
+  if (params.mine && !viewer) {
+    throw new ListingServiceError(
+      "UNAUTHORIZED",
+      "Autentikasi Diperlukan",
+      "Silakan login untuk melihat daftar iklan Anda.",
+      401
+    );
+  }
+
+  const targetSellerId = params.mine ? viewer!.id : params.sellerId;
+  const canViewNonPublic =
+    Boolean(viewer) &&
+    ((Boolean(targetSellerId) && viewer!.id === targetSellerId) ||
+      viewer!.role === "ADMIN");
+
+  if (params.status && params.status !== LISTING_STATUS.ACTIVE && !canViewNonPublic) {
+    // Do not leak ARCHIVED or non-ACTIVE listings through public catalog queries.
+    return {
+      data: [],
+      pagination: { limit, nextCursor: null, hasMore: false },
+    };
+  }
+
+  const conditions: Prisma.Sql[] = [];
+
+  if (params.status) {
+    conditions.push(Prisma.sql`l."status" = ${params.status}`);
+  } else if (params.mine) {
+    conditions.push(
+      Prisma.sql`l."status" IN ('ACTIVE', 'RESERVED', 'SOLD', 'ARCHIVED')`
+    );
+  } else {
+    conditions.push(Prisma.sql`l."status" = 'ACTIVE'`);
+  }
+
+  if (targetSellerId) {
+    conditions.push(Prisma.sql`l."sellerId" = ${targetSellerId}`);
+  }
+
+  if (params.ids && params.ids.length > 0) {
+    conditions.push(Prisma.sql`l."id" IN (${Prisma.join(params.ids)})`);
+  }
+
+  if (params.category && params.category !== "all") {
+    conditions.push(Prisma.sql`l."category" = ${params.category}`);
+  }
+
+  if (params.brand) {
+    const escapedBrand = escapeLikePattern(params.brand.trim());
+    conditions.push(
+      Prisma.sql`l."brand" ILIKE ${`%${escapedBrand}%`} ESCAPE '\\'`
+    );
+  }
+
+  if (params.condition) {
+    const expanded = expandConditionFilter(params.condition);
+    if (expanded.length === 0) {
+      return {
+        data: [],
+        pagination: { limit, nextCursor: null, hasMore: false },
+      };
+    }
+    conditions.push(Prisma.sql`l."condition" IN (${Prisma.join(expanded)})`);
+  }
+
+  if (params.minPrice !== undefined) {
+    conditions.push(Prisma.sql`l."price" >= ${params.minPrice}`);
+  }
+
+  if (params.maxPrice !== undefined) {
+    conditions.push(Prisma.sql`l."price" <= ${params.maxPrice}`);
+  }
+
+  if (params.canNego !== undefined) {
+    conditions.push(Prisma.sql`l."canNego" = ${params.canNego}`);
+  }
+
+  if (params.verifiedOnly) {
+    conditions.push(Prisma.sql`u."isVerified" = true`);
+  }
+
+  if (params.city) {
+    const escapedCity = escapeLikePattern(params.city.trim());
+    conditions.push(
+      Prisma.sql`sp."city" ILIKE ${`%${escapedCity}%`} ESCAPE '\\'`
+    );
+  }
+
+  if (params.q && params.q.trim().length > 0) {
+    const escapedQ = escapeLikePattern(params.q.trim());
+    const pattern = `%${escapedQ}%`;
+    conditions.push(
+      Prisma.sql`(l."title" ILIKE ${pattern} ESCAPE '\\' OR l."brand" ILIKE ${pattern} ESCAPE '\\' OR l."model" ILIKE ${pattern} ESCAPE '\\' OR l."description" ILIKE ${pattern} ESCAPE '\\')`
+    );
+  }
+
+  if (params.cursor) {
+    const c = decodeCursor(params.cursor, sort);
+    // Normalize ISO instant to UTC timestamp without timezone to match Prisma's TIMESTAMP(3) column regardless of PG TimeZone.
+    const cursorTs = Prisma.sql`(${c.createdAt}::timestamptz AT TIME ZONE 'UTC')`;
+
+    if (sort === "newest") {
+      // Bound upper timestamp first so PostgreSQL leverages ProductListing_status_createdAt_id_idx.
+      conditions.push(
+        Prisma.sql`l."createdAt" <= ${cursorTs} AND (l."createdAt" < ${cursorTs} OR l."id" > ${c.id})`
+      );
+    } else if (sort === "price_asc") {
+      if (c.price === undefined) {
+        throw new ListingServiceError(
+          "INVALID_CURSOR",
+          "Cursor Tidak Valid",
+          "Cursor harga tidak lengkap.",
+          400
+        );
+      }
+      conditions.push(
+        Prisma.sql`(l."price" > ${c.price} OR (l."price" = ${c.price} AND (l."createdAt" < ${cursorTs} OR (l."createdAt" = ${cursorTs} AND l."id" > ${c.id}))))`
+      );
+    } else if (sort === "price_desc") {
+      if (c.price === undefined) {
+        throw new ListingServiceError(
+          "INVALID_CURSOR",
+          "Cursor Tidak Valid",
+          "Cursor harga tidak lengkap.",
+          400
+        );
+      }
+      conditions.push(
+        Prisma.sql`(l."price" < ${c.price} OR (l."price" = ${c.price} AND (l."createdAt" < ${cursorTs} OR (l."createdAt" = ${cursorTs} AND l."id" > ${c.id}))))`
+      );
+    } else {
+      if (c.viewsCount === undefined) {
+        throw new ListingServiceError(
+          "INVALID_CURSOR",
+          "Cursor Tidak Valid",
+          "Cursor popularitas tidak lengkap.",
+          400
+        );
+      }
+      conditions.push(
+        Prisma.sql`(l."viewsCount" < ${c.viewsCount} OR (l."viewsCount" = ${c.viewsCount} AND (l."createdAt" < ${cursorTs} OR (l."createdAt" = ${cursorTs} AND l."id" > ${c.id}))))`
+      );
+    }
+  }
+
+  let orderBySql: Prisma.Sql;
+  if (sort === "price_asc") {
+    orderBySql = Prisma.sql`ORDER BY l."price" ASC, l."createdAt" DESC, l."id" ASC`;
+  } else if (sort === "price_desc") {
+    orderBySql = Prisma.sql`ORDER BY l."price" DESC, l."createdAt" DESC, l."id" ASC`;
+  } else if (sort === "popular") {
+    orderBySql = Prisma.sql`ORDER BY l."viewsCount" DESC, l."createdAt" DESC, l."id" ASC`;
+  } else {
+    orderBySql = Prisma.sql`ORDER BY l."createdAt" DESC, l."id" ASC`;
+  }
+
+  const whereClause = Prisma.sql`WHERE ${Prisma.join(conditions, " AND ")}`;
+  const rows = await prisma.$queryRaw<ListingRawRow[]>`
+    ${selectListingColumnsFragment()}
+    ${whereClause}
+    ${orderBySql}
+    LIMIT ${limit + 1}
+  `;
+
+  const hasMore = rows.length > limit;
+  const pageRows = hasMore ? rows.slice(0, limit) : rows;
+  const lastRow = pageRows[pageRows.length - 1];
+
+  const nextCursor =
+    hasMore && lastRow
+      ? encodeCursor({
+          sort,
+          createdAt: new Date(lastRow.createdAt).toISOString(),
+          id: lastRow.id,
+          ...(sort === "price_asc" || sort === "price_desc"
+            ? { price: lastRow.price }
+            : {}),
+          ...(sort === "popular" ? { viewsCount: lastRow.viewsCount } : {}),
+        })
+      : null;
+
+  return {
+    data: pageRows.map((row) => mapListingToDto(row, viewer)),
+    pagination: {
+      limit,
+      nextCursor,
+      hasMore,
+    },
+  };
+}
+
+export async function getListingByIdOrSlug(
+  idOrSlug: string,
+  viewer?: ListingAuthorViewer | null
+): Promise<ListingPublicDto | null> {
+  const rows = await prisma.$queryRaw<ListingRawRow[]>`
+    ${selectListingColumnsFragment()}
+    WHERE l."id" = ${idOrSlug} OR l."slug" = ${idOrSlug}
+    LIMIT 1
+  `;
+  const row = rows[0];
+  if (!row) {
+    return null;
+  }
+
+  if (row.status === LISTING_STATUS.ARCHIVED) {
+    const canSeeArchived =
+      Boolean(viewer) &&
+      (viewer!.id === row.sellerId || viewer!.role === "ADMIN");
+    if (!canSeeArchived) {
+      return null;
+    }
+  }
+
+  return mapListingToDto(row, viewer);
+}
