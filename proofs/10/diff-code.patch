+        role: "BUYER",
+        isVerified: true,
+        hashedPassword: "SENTINEL_HASHED_PASSWORD_B",
+        hashedPin: "SENTINEL_HASHED_PIN_B",
+        totpSecretCiphertext: "SENTINEL_TOTP_B",
+        accountStatus: "ACTIVE",
+        sessionVersion: 1,
