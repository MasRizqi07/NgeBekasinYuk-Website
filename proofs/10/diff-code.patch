+
+  it("AC10.2: Keyset cursor pagination does not duplicate or skip items under concurrent insert", async () => {
+    currentSessionCookie = sellerCookieA;
+    const tag = crypto.randomBytes(3).toString("hex");
+    const initialIds: string[] = [];
