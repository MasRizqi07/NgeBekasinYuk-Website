# ========================================================
# NgeBekasinYuk Root Environment Configuration Example
# ========================================================

# DATABASE CONFIGURATION (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ngebekasinyuk_db?schema=public"

# AUTHENTICATION & SECRETS
# Minimum 32 characters in production
AUTH_SECRET="dev-secret-change-in-production-min-32-chars-key"
SESSION_COOKIE_NAME="ngebekasinyuk_session"

# ADMIN 2FA STEP-UP CONFIGURATION
ADMIN_STEP_UP_SECRET="dev-admin-step-up-secret-key-32-chars"
ADMIN_STEP_UP_TTL_SECONDS="300"

# PROVIDER CONFIGURATION (HONEST LABELING)
DEMO_PAYMENT_PROVIDER=true
DEMO_KYC_PROVIDER=true
DEMO_WITHDRAWAL_PROVIDER=true
ALLOW_DEMO_IN_PRODUCTION=false

# PUBLIC APP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
